effect {
 Name : "Draw" ,
 Action: (targets , context) => {

topCard= context.Deck.Pop();
context.Hand.Add(topCard);
context.Hand.Shuffle();
}
}

effect {
Name : "ReturnToDeck" ,
Action: (targets , context) => {
  for target in targets {

   owner=target.Owner;
   deck=context.DeckOfPlayer(owner);
   deck.Push(target);
  deck.Shuffle();
  context.Board.Remove(target);
      };
     }
  }

card {
            Type: "Oro" ,
	 Name: "Travis" ,
	Faction : "RockStar" ,
         Power: 10 ,
         Range :["Melee" , "Ranged"] ,
         
   OnActivation: [ 
   {
      Effect : {
          Name : "ReturnToDeck" ,
    },
       Selector : { 
	Source : "otherField",
          Single: false ,
          Predicate: (unit)=> unit.Power <=15 
  },
     PostAction : {
         Type : "Draw" ,
    }
}
]
}
                        
    



